# Copy to .env.local and fill in. .env.local is gitignored; never commit real values.

# Supabase (Project Settings > API, or the output of `supabase start` for local dev)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses row-level security, so it must never reach the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Last.fm API key (https://www.last.fm/api/account/create). Server only.
LASTFM_API_KEY=

# Spotify app credentials, used for client-credentials search only (no user login). Optional.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# A long random string. The scheduler sends it to /api/cron/lastfm so nobody else can
# trigger the automatic Last.fm reader. Generate one with: openssl rand -hex 32
CRON_SECRET=
